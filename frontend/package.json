{
  "name": "bolivia-fire-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",

    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.19.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
